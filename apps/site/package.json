{
  "name": "@shipthat/site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/",
