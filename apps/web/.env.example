# Copy to .env.local and fill in. The first five are needed, locally and in
# production. The Stripe pair is only for shipth.at Cloud.

# Postgres. Locally the one from `docker compose up -d db`; in production
# Neon's pooled string.
DATABASE_URL=postgres://postgres:leanear@localhost:5432/postgres

# Better Auth's secret: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the app runs: Better Auth's base URL and the MCP URL shown in the app.
PUBLIC_URL=http://localhost:3000

# A GitHub OAuth app (github.com/settings/developers), the only way to sign in.
# Use one app per URL: its callback is <PUBLIC_URL>/api/auth/callback/github.
GITHUB_ID=
GITHUB_SECRET=

# shipth.at Cloud billing. Leave both out and there's no plan and no caps, which
# is what a self-hosted copy wants.
# A Stripe secret or restricted key (sk_test_ or rk_test_ while testing).
STRIPE_SECRET_KEY=
# The webhook's signing secret (whsec_), for <PUBLIC_URL>/api/stripe.
STRIPE_WEBHOOK_SECRET=

# Email, for sending invites. Leave it out and invites are links to copy.
# A Resend API key (resend.com, API Keys), and a sender on a domain you've
# verified there.
RESEND_API_KEY=
EMAIL_FROM="shipth.at <hello@shipth.at>"
