# Copy to .env.local and fill in. All five are needed, locally and in production.

# Postgres. Locally the one from `docker compose up -d`; in production Neon's
# pooled string.
DATABASE_URL=postgres://postgres:leanear@localhost:5432/postgres

# Better Auth's secret: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the app runs: Better Auth's base URL and the MCP URL shown in the app.
PUBLIC_URL=http://localhost:3000

# A GitHub OAuth app (github.com/settings/developers), the only way to sign in.
# Use one app per URL: its callback is <PUBLIC_URL>/api/auth/callback/github.
GITHUB_ID=
GITHUB_SECRET=
