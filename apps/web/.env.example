# None of these are needed for `pnpm dev`: without DATABASE_URL the app uses an
# embedded Postgres in .data/, and you sign in with an email and password.

# Postgres (Neon works; use the pooled string). Migrations run before `next build`.
DATABASE_URL=

# Better Auth. Required in production: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the app runs. Better Auth's base URL, and the MCP URL shown in the app.
PUBLIC_URL=https://app.leanear.app

# GitHub OAuth app. Callback: <PUBLIC_URL>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Optional Google OAuth client. Callback: <PUBLIC_URL>/api/auth/callback/google
GOOGLE_ID=
GOOGLE_SECRET=
