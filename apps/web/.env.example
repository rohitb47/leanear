# None of these are needed for `pnpm dev`: without DATABASE_URL the app uses an
# embedded Postgres in .data/, and you sign in locally with a name and email.

# Postgres (Neon works). Migrations run before `next build` when this is set.
DATABASE_URL=

# Where the app runs. Used for OAuth callbacks and the MCP URL shown in the app.
PUBLIC_URL=https://app.leanear.app

# GitHub OAuth app. Callback: <PUBLIC_URL>/auth/github/callback
GITHUB_ID=
GITHUB_SECRET=

# Optional Google OAuth client. Callback: <PUBLIC_URL>/auth/google/callback
GOOGLE_ID=
GOOGLE_SECRET=
